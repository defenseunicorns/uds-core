          "type": "boolean"
        },
        "server": {
          "type": "string"
        },
        "enableHttpsRedirect": {
          "type": "boolean"
        },
        "tls": {
          "type": "object"
        }
      }
    },
    "proxyProtocol": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
