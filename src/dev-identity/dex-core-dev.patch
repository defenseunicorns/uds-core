diff --git a/storage/kubernetes/core_client_list_test.go b/storage/kubernetes/core_client_list_test.go
new file mode 100644
index 00000000..2baec6c5
--- /dev/null
+++ b/storage/kubernetes/core_client_list_test.go
@@ -0,0 +1,58 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package kubernetes
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestCoreClientListUsesActualNamespaceAndPreservesClientAuthority(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodGet || request.URL.Path != "/apis/dex.coreos.com/v1/namespaces/dex-public/oauth2clients" {
+			t.Errorf("unexpected actual storage request: %s %s", request.Method, request.URL.Path)
+			writer.WriteHeader(400)
+			return
+		}
+		json.NewEncoder(writer).Encode(ClientList{Clients: []Client{{ID: "actual-client", Secret: "actual-secret", Public: false, RedirectURIs: []string{"https://app.example.test/callback"}, TrustedPeers: []string{"actual-probe"}}}})
+	}))
+	defer server.Close()
+	client := &client{baseURL: server.URL, namespace: "dex-public", apiVersion: "dex.coreos.com/v1", client: server.Client()}
+	clients, err := client.ListClients(t.Context())
+	if err != nil || len(clients) != 1 || clients[0].ID != "actual-client" || clients[0].Secret != "actual-secret" || clients[0].Public || len(clients[0].TrustedPeers) != 1 {
+		t.Fatal("storage client authority did not survive list", err)
+	}
+}
+
+func TestCoreClientListNeverTurnsAPIFailureIntoEmptyAuthority(t *testing.T) {
+	for _, status := range []int{401, 403, 500} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) { writer.WriteHeader(status) }))
+			defer server.Close()
+			client := &client{baseURL: server.URL, namespace: "dex-public", apiVersion: "dex.coreos.com/v1", client: server.Client()}
+			if _, err := client.ListClients(t.Context()); err == nil {
+				t.Fatal("API error became empty client authority")
+			}
+		})
+	}
+}
+
+func TestCoreClientListRespectsCancellation(t *testing.T) {
+	started := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) { close(started); <-request.Context().Done() }))
+	defer server.Close()
+	client := &client{baseURL: server.URL, namespace: "dex-public", apiVersion: "dex.coreos.com/v1", client: server.Client()}
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := client.ListClients(ctx); done <- err }()
+	<-started
+	cancel()
+	if err := <-done; err == nil {
+		t.Fatal("cancelled storage list succeeded")
+	}
+}
