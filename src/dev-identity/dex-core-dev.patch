diff --git a/connector/authproxy/core_identity_test.go b/connector/authproxy/core_identity_test.go
new file mode 100644
index 00000000..3922578b
--- /dev/null
+++ b/connector/authproxy/core_identity_test.go
@@ -0,0 +1,41 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package authproxy
+
+import (
+	"log/slog"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"github.com/dexidp/dex/connector"
+)
+
+func TestCoreClaimsRetainLiteralGroupsAndVerifiedEmailAuthority(t *testing.T) {
+	configuration := Config{GroupHeaderEncoding: "json", EmailVerifiedHeader: "X-Remote-Email-Verified"}
+	opened, err := configuration.Open("uds", slog.Default())
+	if err != nil {
+		t.Fatal(err)
+	}
+	callback := opened.(connector.CallbackConnector)
+	request := httptest.NewRequest("GET", "https://identity.example.test/callback/uds", nil)
+	request.Header.Set("X-Remote-User", "actual-user")
+	request.Header.Set("X-Remote-User-Id", "actual-user-id")
+	request.Header.Set("X-Remote-User-Email", "user@example.test")
+	request.Header.Set("X-Remote-Email-Verified", "false")
+	request.Header.Set("X-Remote-Group", `["/literal, /UDS Core/Admin"]`)
+	identity, err := callback.HandleCallback(connector.Scopes{}, nil, request)
+	if err != nil || identity.EmailVerified || !reflect.DeepEqual(identity.Groups, []string{"/literal, /UDS Core/Admin"}) {
+		t.Fatal("directory claim authority changed", identity, err)
+	}
+	request.Header.Set("X-Remote-Group", `invalid JSON`)
+	if _, err := callback.HandleCallback(connector.Scopes{}, nil, request); err == nil {
+		t.Fatal("invalid group state accepted")
+	}
+	request.Header.Set("X-Remote-Group", `[]`)
+	request.Header.Del("X-Remote-Email-Verified")
+	if _, err := callback.HandleCallback(connector.Scopes{}, nil, request); err == nil {
+		t.Fatal("unknown email verification accepted")
+	}
+}
diff --git a/connector/authproxy/refresh.go b/connector/authproxy/refresh.go
new file mode 100644
index 00000000..20a2209e
--- /dev/null
+++ b/connector/authproxy/refresh.go
@@ -0,0 +1,99 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package authproxy
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"github.com/dexidp/dex/connector"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"time"
+)
+
+// Refresh is opt-in. Existing authproxy deployments keep their original
+// callback-only behavior. Core's private identity lookup requires mutual TLS
+// and refreshes group membership instead of trusting stale callback claims.
+type RefreshConfig struct {
+	Endpoint   string `json:"endpoint"`
+	RootCA     string `json:"rootCA"`
+	ClientCert string `json:"clientCert"`
+	ClientKey  string `json:"clientKey"`
+}
+
+type refreshCallback struct {
+	*callback
+	endpoint *url.URL
+	client   *http.Client
+}
+
+func newRefreshCallback(base *callback, cfg RefreshConfig) (connector.Connector, error) {
+	endpoint, err := url.Parse(cfg.Endpoint)
+	if err != nil || endpoint.Scheme != "https" || endpoint.Host == "" {
+		return nil, fmt.Errorf("authproxy refresh requires HTTPS endpoint")
+	}
+	roots := x509.NewCertPool()
+	raw, err := os.ReadFile(cfg.RootCA)
+	if err != nil || !roots.AppendCertsFromPEM(raw) {
+		return nil, fmt.Errorf("invalid authproxy refresh root CA")
+	}
+	certificate, err := tls.LoadX509KeyPair(cfg.ClientCert, cfg.ClientKey)
+	if err != nil {
+		return nil, fmt.Errorf("authproxy refresh client certificate: %w", err)
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: roots, Certificates: []tls.Certificate{certificate}}}
+	return &refreshCallback{callback: base, endpoint: endpoint, client: &http.Client{Transport: transport, Timeout: 5 * time.Second}}, nil
+}
+
+func (c *refreshCallback) Refresh(ctx context.Context, scopes connector.Scopes, identity connector.Identity) (connector.Identity, error) {
+	endpoint := *c.endpoint
+	query := endpoint.Query()
+	query.Set("userId", identity.UserID)
+	endpoint.RawQuery = query.Encode()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return connector.Identity{}, err
+	}
+	response, err := c.client.Do(request)
+	if err != nil {
+		return connector.Identity{}, err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return connector.Identity{}, fmt.Errorf("authproxy identity refresh rejected: %d", response.StatusCode)
+	}
+	var user struct {
+		ID, Username, Email string
+		Groups              []string
+		EmailVerified       bool
+		SessionVersion      uint64
+	}
+	if err := json.NewDecoder(io.LimitReader(response.Body, 1<<20)).Decode(&user); err != nil {
+		return connector.Identity{}, err
+	}
+	if user.ID != identity.UserID || user.Username == "" || user.Email == "" {
+		return connector.Identity{}, fmt.Errorf("authproxy identity refresh mismatch")
+	}
+	if c.sessionVersionHeader != "" {
+		var data struct {
+			Version uint64 `json:"version"`
+		}
+		if json.Unmarshal(identity.ConnectorData, &data) != nil || data.Version != user.SessionVersion {
+			return connector.Identity{}, fmt.Errorf("authproxy credential/session authority revoked")
+		}
+	}
+	identity.Username = user.Username
+	identity.PreferredUsername = user.Username
+	identity.Email = user.Email
+	if c.emailVerifiedHeader != "" {
+		identity.EmailVerified = user.EmailVerified
+	}
+	identity.Groups = user.Groups
+	return identity, nil
+}
