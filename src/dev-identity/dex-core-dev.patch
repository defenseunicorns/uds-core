--- /dev/null
+++ b/server/development_pkce_test.go
@@ -0,0 +1,127 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package server
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/dexidp/dex/storage"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDevelopmentPublicClientRequiresS256AtAuthorization(t *testing.T) {
+	httpServer, s := newTestServer(t, nil)
+	defer httpServer.Close()
+	s.developmentIdentity = &developmentIdentity{}
+	require.NoError(t, s.storage.CreateClient(t.Context(), storage.Client{ID: "cli", Public: true, RedirectURIs: []string{"https://app.example.test/callback"}}))
+	verifier := strings.Repeat("v", 43)
+	hash := sha256.Sum256([]byte(verifier))
+	challenge := base64.RawURLEncoding.EncodeToString(hash[:])
+	for name, extra := range map[string]url.Values{
+		"missing": {}, "plain": {"code_challenge": {verifier}, "code_challenge_method": {"plain"}}, "method-omitted": {"code_challenge": {challenge}}, "short": {"code_challenge": {"short"}, "code_challenge_method": {"S256"}}, "duplicate-method": {"code_challenge": {challenge}, "code_challenge_method": {"S256", "plain"}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			q := url.Values{"client_id": {"cli"}, "response_type": {"code"}, "scope": {"openid"}, "redirect_uri": {"https://app.example.test/callback"}}
+			for key, value := range extra {
+				q[key] = value
+			}
+			_, err := s.parseAuthorizationRequest(httptest.NewRequest(http.MethodGet, httpServer.URL+"/auth?"+q.Encode(), nil))
+			require.Error(t, err)
+		})
+	}
+	q := url.Values{"client_id": {"cli"}, "response_type": {"code"}, "scope": {"openid"}, "redirect_uri": {"https://app.example.test/callback"}, "code_challenge": {challenge}, "code_challenge_method": {"S256"}}
+	auth, err := s.parseAuthorizationRequest(httptest.NewRequest(http.MethodGet, httpServer.URL+"/auth?"+q.Encode(), nil))
+	require.NoError(t, err)
+	require.Equal(t, storage.PKCE{CodeChallenge: challenge, CodeChallengeMethod: "S256"}, auth.PKCE)
+	// Upstream mode remains unchanged without native development identity.
+	s.developmentIdentity = nil
+	q.Del("code_challenge")
+	q.Del("code_challenge_method")
+	_, err = s.parseAuthorizationRequest(httptest.NewRequest(http.MethodGet, httpServer.URL+"/auth?"+q.Encode(), nil))
+	require.NoError(t, err)
+}
+
+func TestDevelopmentPublicTokenRejectsLegacyUnboundAndPlainCodes(t *testing.T) {
+	httpServer, s := newTestServer(t, nil)
+	defer httpServer.Close()
+	s.developmentIdentity = &developmentIdentity{}
+	client := storage.Client{ID: "cli", Public: true, RedirectURIs: []string{"https://app.example.test/callback"}}
+	require.NoError(t, s.storage.CreateClient(t.Context(), client))
+	verifier := strings.Repeat("v", 43)
+	hash := sha256.Sum256([]byte(verifier))
+	challenge := base64.RawURLEncoding.EncodeToString(hash[:])
+	for name, item := range map[string]struct {
+		pkce     storage.PKCE
+		verifier string
+	}{
+		"pre-checkpoint-unbound": {storage.PKCE{}, ""}, "plain": {storage.PKCE{CodeChallenge: verifier, CodeChallengeMethod: "plain"}, verifier}, "missing-verifier": {storage.PKCE{CodeChallenge: challenge, CodeChallengeMethod: "S256"}, ""}, "wrong-verifier": {storage.PKCE{CodeChallenge: challenge, CodeChallengeMethod: "S256"}, strings.Repeat("w", 43)},
+	} {
+		t.Run(name, func(t *testing.T) {
+			code := storage.AuthCode{ID: name, ClientID: "cli", RedirectURI: "https://app.example.test/callback", Expiry: time.Now().Add(time.Minute), PKCE: item.pkce}
+			require.NoError(t, s.storage.CreateAuthCode(t.Context(), code))
+			form := url.Values{"grant_type": {"authorization_code"}, "client_id": {"cli"}, "redirect_uri": {code.RedirectURI}, "code": {name}, "code_verifier": {item.verifier}}
+			request := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(form.Encode()))
+			request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			require.NoError(t, request.ParseForm())
+			response := httptest.NewRecorder()
+			s.handleAuthCode(response, request, client)
+			require.Equal(t, 400, response.Code)
+			var errorBody map[string]string
+			require.NoError(t, json.Unmarshal(response.Body.Bytes(), &errorBody))
+			require.Equal(t, errInvalidGrant, errorBody["error"])
+		})
+	}
+}
+
+func TestDevelopmentPublicAudienceIsRealIDTokenOnlyWithStableSubject(t *testing.T) {
+	httpServer, s := newTestServer(t, nil)
+	defer httpServer.Close()
+	s.developmentIdentity = &developmentIdentity{}
+	require.NoError(t, s.storage.CreateClient(t.Context(), storage.Client{ID: "cli", Public: true}))
+	require.NoError(t, s.storage.CreateClient(t.Context(), storage.Client{ID: "server", Secret: "server-secret", TrustedPeers: []string{"cli"}}))
+	claims := storage.Claims{UserID: "real-directory-id", Username: "Owner", PreferredUsername: "owner", Groups: []string{"/UDS Core/Admin"}, Email: "owner@example.test", EmailVerified: true}
+	scopes := []string{scopeOpenID, scopeProfile, scopeEmail, scopeGroups, "audience:server:client_id:server"}
+	idToken, _, err := s.newIDToken(t.Context(), "cli", claims, scopes, "nonce", "", "", "uds")
+	require.NoError(t, err)
+	accessToken, _, err := s.newAccessToken(t.Context(), "cli", claims, scopes, "nonce", "uds")
+	require.NoError(t, err)
+	webToken, _, err := s.newIDToken(t.Context(), "server", claims, scopes[:4], "nonce", "", "", "uds")
+	require.NoError(t, err)
+	verify := func(token, clientID string) *oidc.IDToken {
+		v := oidc.NewVerifier(httpServer.URL, oidc.NewRemoteKeySet(t.Context(), httpServer.URL+"/keys"), &oidc.Config{ClientID: clientID})
+		actual, err := v.Verify(t.Context(), token)
+		require.NoError(t, err)
+		return actual
+	}
+	id := verify(idToken, "server")
+	require.ElementsMatch(t, []string{"cli", "server"}, id.Audience)
+	access := verify(accessToken, "cli")
+	require.Equal(t, []string{"cli"}, access.Audience)
+	require.Equal(t, id.Subject, access.Subject)
+	require.Equal(t, id.Subject, verify(webToken, "server").Subject)
+	var signed struct {
+		AZP      string   `json:"azp"`
+		Name     string   `json:"name"`
+		Username string   `json:"preferred_username"`
+		Groups   []string `json:"groups"`
+	}
+	require.NoError(t, id.Claims(&signed))
+	require.Equal(t, "cli", signed.AZP)
+	require.Equal(t, "Owner", signed.Name)
+	require.Equal(t, "owner", signed.Username)
+	require.Equal(t, claims.Groups, signed.Groups)
+	// Revoking actual stored trust prevents a subsequent signature, including refresh.
+	require.NoError(t, s.storage.UpdateClient(t.Context(), "server", func(client storage.Client) (storage.Client, error) { client.TrustedPeers = nil; return client, nil }))
+	_, _, err = s.newIDToken(t.Context(), "cli", claims, scopes, "nonce", "", "", "uds")
+	require.Error(t, err)
+}
