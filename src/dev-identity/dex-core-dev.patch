diff --git a/server/development_generation.go b/server/development_generation.go
new file mode 100644
index 00000000..8a67f7cb
--- /dev/null
+++ b/server/development_generation.go
@@ -0,0 +1,47 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package server
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+const developmentGenerationPrefix = "uds:package-generation:"
+
+var developmentGenerationValue = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+func developmentGrantGeneration(scopes []string) (string, error) {
+	result := ""
+	for _, scope := range scopes {
+		if !strings.HasPrefix(scope, developmentGenerationPrefix) {
+			continue
+		}
+		value := strings.TrimPrefix(scope, developmentGenerationPrefix)
+		if result != "" || !developmentGenerationValue.MatchString(value) {
+			return "", fmt.Errorf("invalid native grant generation")
+		}
+		result = value
+	}
+	return result, nil
+}
+
+func retainDevelopmentGrantGeneration(original, requested []string) ([]string, error) {
+	value, err := developmentGrantGeneration(original)
+	if err != nil {
+		return nil, err
+	}
+	requestedValue, err := developmentGrantGeneration(requested)
+	if err != nil {
+		return nil, err
+	}
+	if requestedValue != "" && requestedValue != value {
+		return nil, fmt.Errorf("refresh cannot choose another generation")
+	}
+	if value != "" && requestedValue == "" {
+		requested = append(append([]string(nil), requested...), developmentGenerationPrefix+value)
+	}
+	return requested, nil
+}
diff --git a/server/development_generation_test.go b/server/development_generation_test.go
new file mode 100644
index 00000000..9c0404b8
--- /dev/null
+++ b/server/development_generation_test.go
@@ -0,0 +1,102 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package server
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDevelopmentOriginalGenerationSurvivesRefreshScopeNarrowing(t *testing.T) {
+	old := developmentGenerationPrefix + strings.Repeat("a", 64)
+	scopes, err := retainDevelopmentGrantGeneration([]string{scopeOpenID, scopeGroups, old}, []string{scopeOpenID})
+	require.NoError(t, err)
+	require.Equal(t, []string{scopeOpenID, old}, scopes)
+	_, err = retainDevelopmentGrantGeneration([]string{old}, []string{developmentGenerationPrefix + strings.Repeat("b", 64)})
+	require.Error(t, err)
+	for _, scopes := range [][]string{{old, old}, {developmentGenerationPrefix + "short"}, {developmentGenerationPrefix + strings.Repeat("A", 64)}} {
+		_, err := developmentGrantGeneration(scopes)
+		require.Error(t, err)
+	}
+	original := []string{scopeOpenID, scopeProfile}
+	actual, err := retainDevelopmentGrantGeneration(original, original)
+	require.NoError(t, err)
+	require.Equal(t, original, actual)
+}
+
+func TestDevelopmentSameClientIDRecreationCannotAdoptOriginalRefreshGrant(t *testing.T) {
+	generation := strings.Repeat("a", 64)
+	authorityCalls := 0
+	authority, cfg := developmentAuthority(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		authorityCalls++
+		require.NotEmpty(t, r.TLS.VerifiedChains)
+		if r.URL.Query().Get("clientId") != "cli" || r.URL.Query().Get("userId") != "owner" || r.URL.Query().Get("clientGeneration") != generation {
+			w.WriteHeader(403)
+			return
+		}
+		w.WriteHeader(204)
+	}))
+	cfg.UserAuthorizationEndpoint = authority.URL + "/internal/user-authorization"
+	httpServer, s := newTestServer(t, func(c *Config) { c.DevelopmentIdentity = &cfg })
+	defer httpServer.Close()
+	require.NoError(t, s.storage.CreateConnector(t.Context(), storage.Connector{ID: "uds", Type: "mockCallback", Name: "unit trusted directory", ResourceVersion: "1"}))
+	cli := storage.Client{ID: "cli", Public: true, RedirectURIs: []string{"https://app.example.test/callback"}}
+	require.NoError(t, s.storage.CreateClient(t.Context(), cli))
+	verifier := strings.Repeat("v", 43)
+	hash := sha256.Sum256([]byte(verifier))
+	challenge := base64.RawURLEncoding.EncodeToString(hash[:])
+	issueCode := func(gen string) string {
+		code := storage.NewID()
+		require.NoError(t, s.storage.CreateAuthCode(t.Context(), storage.AuthCode{ID: code, ClientID: "cli", ConnectorID: "uds", RedirectURI: cli.RedirectURIs[0], Expiry: time.Now().Add(time.Minute), Nonce: "real-nonce", Scopes: []string{scopeOpenID, scopeOfflineAccess, developmentGenerationPrefix + gen}, Claims: storage.Claims{UserID: "owner", Username: "Owner", PreferredUsername: "owner"}, PKCE: storage.PKCE{CodeChallenge: challenge, CodeChallengeMethod: "S256"}}))
+		return code
+	}
+	exchange := func(code string) *http.Response {
+		response, err := http.PostForm(httpServer.URL+"/token", url.Values{"client_id": {"cli"}, "grant_type": {"authorization_code"}, "code": {code}, "redirect_uri": {cli.RedirectURIs[0]}, "code_verifier": {verifier}})
+		require.NoError(t, err)
+		return response
+	}
+	response := exchange(issueCode(generation))
+	require.Equal(t, 200, response.StatusCode)
+	var tokens struct {
+		ID      string `json:"id_token"`
+		Refresh string `json:"refresh_token"`
+	}
+	require.NoError(t, json.NewDecoder(response.Body).Decode(&tokens))
+	response.Body.Close()
+	require.NotEmpty(t, tokens.ID)
+	require.NotEmpty(t, tokens.Refresh)
+	originalCalls := authorityCalls
+	require.Greater(t, originalCalls, 0)
+	// The same logical client ID is genuinely replaced in Dex storage.
+	require.NoError(t, s.storage.DeleteClient(t.Context(), "cli"))
+	require.NoError(t, s.storage.CreateClient(t.Context(), cli))
+	generation = strings.Repeat("b", 64)
+	for _, scope := range []string{"", scopeOpenID, scopeOpenID + " " + developmentGenerationPrefix + generation} {
+		response, err := http.PostForm(httpServer.URL+"/token", url.Values{"client_id": {"cli"}, "grant_type": {"refresh_token"}, "refresh_token": {tokens.Refresh}, "scope": {scope}})
+		require.NoError(t, err)
+		require.Equal(t, 400, response.StatusCode)
+		var failure map[string]string
+		require.NoError(t, json.NewDecoder(response.Body).Decode(&failure))
+		response.Body.Close()
+		require.Equal(t, errInvalidGrant, failure["error"])
+	}
+	// An outstanding code from the old UID also cannot obtain a signature.
+	response = exchange(issueCode(strings.Repeat("a", 64)))
+	require.GreaterOrEqual(t, response.StatusCode, 400)
+	response.Body.Close()
+	// A fresh S256 authorization grant for the replacement is usable.
+	response = exchange(issueCode(generation))
+	require.Equal(t, 200, response.StatusCode)
+	response.Body.Close()
+	require.Greater(t, authorityCalls, originalCalls)
+}
diff --git a/server/development_identity.go b/server/development_identity.go
new file mode 100644
index 00000000..3ae0bddc
--- /dev/null
+++ b/server/development_identity.go
@@ -0,0 +1,141 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package server
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// DevelopmentIdentityConfig is opt-in and requires a private HTTPS authority
+// with mutual TLS. It supplies managed service-account claims after Dex's
+// ordinary client-secret verification. The caller cannot select identity,
+// groups, or additional audiences.
+type DevelopmentIdentityConfig struct {
+	Endpoint                  string `json:"endpoint"`
+	RootCA                    string `json:"rootCA"`
+	ClientCert                string `json:"clientCert"`
+	ClientKey                 string `json:"clientKey"`
+	UserAuthorizationEndpoint string `json:"userAuthorizationEndpoint,omitempty"`
+}
+
+type developmentIdentity struct {
+	endpoint                  *url.URL
+	client                    *http.Client
+	userAuthorizationEndpoint *url.URL
+}
+
+func newDevelopmentIdentity(cfg DevelopmentIdentityConfig) (*developmentIdentity, error) {
+	endpoint, err := url.Parse(cfg.Endpoint)
+	if err != nil || endpoint.Scheme != "https" || endpoint.Host == "" {
+		return nil, fmt.Errorf("development identity requires HTTPS")
+	}
+	raw, err := os.ReadFile(cfg.RootCA)
+	if err != nil {
+		return nil, err
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(raw) {
+		return nil, fmt.Errorf("invalid development identity trust root")
+	}
+	cert, err := tls.LoadX509KeyPair(cfg.ClientCert, cfg.ClientKey)
+	if err != nil {
+		return nil, err
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: roots, Certificates: []tls.Certificate{cert}}}
+	identity := &developmentIdentity{endpoint: endpoint, client: &http.Client{Transport: transport, Timeout: 5 * time.Second}}
+	if cfg.UserAuthorizationEndpoint != "" {
+		identity.userAuthorizationEndpoint, err = url.Parse(cfg.UserAuthorizationEndpoint)
+		if err != nil || identity.userAuthorizationEndpoint.Scheme != "https" || identity.userAuthorizationEndpoint.Host == "" {
+			return nil, fmt.Errorf("user authorization requires HTTPS")
+		}
+	}
+	return identity, nil
+}
+
+func (s *Server) authorizeDevelopmentUser(ctx context.Context, clientID, userID, connectorID string, scopes []string) error {
+	if s.developmentIdentity == nil || s.developmentIdentity.userAuthorizationEndpoint == nil || connectorID != "uds" {
+		return nil
+	}
+	generation, err := developmentGrantGeneration(scopes)
+	if err != nil {
+		return err
+	}
+	endpoint := *s.developmentIdentity.userAuthorizationEndpoint
+	query := endpoint.Query()
+	query.Set("clientId", clientID)
+	query.Set("userId", userID)
+	if generation != "" {
+		query.Set("clientGeneration", generation)
+	}
+	endpoint.RawQuery = query.Encode()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return err
+	}
+	response, err := s.developmentIdentity.client.Do(request)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 204 {
+		return fmt.Errorf("development user authorization rejected: %d", response.StatusCode)
+	}
+	return nil
+}
+
+func (s *Server) handleDevelopmentClientCredentials(writer http.ResponseWriter, request *http.Request, client storage.Client) {
+	if s.developmentIdentity == nil || client.Public {
+		s.tokenErrHelper(writer, errUnauthorizedClient, "service-account grant unavailable", 401)
+		return
+	}
+	endpoint := *s.developmentIdentity.endpoint
+	query := endpoint.Query()
+	query.Set("clientId", client.ID)
+	endpoint.RawQuery = query.Encode()
+	lookup, err := http.NewRequestWithContext(request.Context(), http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		s.tokenErrHelper(writer, errServerError, "identity lookup unavailable", 503)
+		return
+	}
+	response, err := s.developmentIdentity.client.Do(lookup)
+	if err != nil {
+		s.tokenErrHelper(writer, errServerError, "identity lookup unavailable", 503)
+		return
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 200 {
+		s.tokenErrHelper(writer, errUnauthorizedClient, "service-account grant rejected", 401)
+		return
+	}
+	var identity struct {
+		ClientID, ID, Username string
+		Groups, Audiences      []string
+	}
+	if json.NewDecoder(io.LimitReader(response.Body, 1<<20)).Decode(&identity) != nil || identity.ClientID != client.ID || identity.ID == "" || identity.Username == "" {
+		s.tokenErrHelper(writer, errServerError, "invalid managed identity", 503)
+		return
+	}
+	scopes := []string{scopeProfile, scopeGroups}
+	for _, audience := range identity.Audiences {
+		scopes = append(scopes, "audience:server:client_id:"+audience)
+	}
+	claims := storage.Claims{UserID: identity.ID, Username: identity.Username, PreferredUsername: identity.Username, Groups: identity.Groups}
+	token, expiry, err := s.newAccessToken(request.Context(), client.ID, claims, scopes, "", "uds-service-account")
+	if err != nil {
+		s.tokenErrHelper(writer, errServerError, "could not issue service-account token", 503)
+		return
+	}
+	s.writeAccessToken(writer, &accessTokenResponse{AccessToken: token, TokenType: "bearer", ExpiresIn: int(expiry.Sub(s.now()).Seconds())})
+}
