--- /dev/null
+++ b/server/development_pkce.go
@@ -0,0 +1,36 @@
+// Copyright 2026 The Dex Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package server
+
+import (
+	"net/url"
+	"regexp"
+
+	"github.com/dexidp/dex/storage"
+)
+
+var developmentS256Challenge = regexp.MustCompile(`^[A-Za-z0-9_-]{43}$`)
+var developmentVerifier = regexp.MustCompile(`^[A-Za-z0-9._~-]{43,128}$`)
+
+func validDevelopmentPKCEAuthorization(values url.Values) bool {
+	return len(values["code_challenge"]) == 1 && len(values["code_challenge_method"]) == 1 &&
+		values.Get("code_challenge_method") == codeChallengeMethodS256 && developmentS256Challenge.MatchString(values.Get("code_challenge")) &&
+		values.Get("response_type") == responseTypeCode
+}
+func validDevelopmentPKCEToken(values url.Values, pkce storage.PKCE) bool {
+	return pkce.CodeChallengeMethod == codeChallengeMethodS256 && developmentS256Challenge.MatchString(pkce.CodeChallenge) &&
+		len(values["code_verifier"]) == 1 && developmentVerifier.MatchString(values.Get("code_verifier"))
+}
+
+// The native public CLI declares an ID-token audience mapper. Keep its access
+// token bound to the CLI itself rather than implicitly widening both tokens.
+func developmentPublicAccessScopes(scopes []string) []string {
+	result := make([]string, 0, len(scopes))
+	for _, scope := range scopes {
+		if _, crossClient := parseCrossClientScope(scope); !crossClient {
+			result = append(result, scope)
+		}
+	}
+	return result
+}
diff --git a/server/development_pkce_test.go b/server/development_pkce_test.go
