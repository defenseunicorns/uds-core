    {
      "name": "Test validation of Exemption CRs > allows default namespace",
      "kind": "Exemption",
      "object": {
        "metadata": {
          "namespace": "uds-policy-exemptions",
          "name": "exemption"
        },
        "spec": {
          "exemptions": [
            {
              "policies": [
                "DisallowPrivileged"
              ],
              "matcher": {
                "name": "^falco-pod.*",
                "namespace": "falco",
                "kind": "pod"
              }
            }
          ]
        }
      },
      "allowAll": false,
      "message": "",
      "allowed": true
    },
    {
