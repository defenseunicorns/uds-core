amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

steps {
    ["yamllint"] {
        check = "yamllint . -c .yamllint --no-warnings"
        glob = List("**/*.yaml", "**/*.yml", ".yamllint")
    }
    ["codespell"] {
        check = "codespell"
        fix = "codespell -w"
        glob = List("**/*")
        exclude = List("build/**", "vendor/**", "uds-docs/**", "package-lock.json")
    }
    ["typescript-format"] {
        check = "npx eslint {{files}} && npx prettier --check {{files}}"
        fix = "npx eslint --fix {{files}} && npx prettier --write {{files}}"
        glob = List("**/*.ts")
    }
    ["license-check"] {
        check = "uds run -f tasks/lint.yaml license"
        fix = "uds run -f tasks/lint.yaml fix-license"
        glob = List("**/*")
        exclude = List("build/**", "vendor/**", "uds-docs/**")
    }
}
