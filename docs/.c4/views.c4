views "uds-core" {
  // Overviews
  view index of infrastructure {
    title "Overviews / Namespaces"
    autoLayout TopBottom 75 50

    group {
      border solid
      color background
      opacity 100%

      include
        *,
        cluster.generic-customer,
        cluster.pepr-system,
        cluster.istio-egress-ambient,
        cluster.istio-egress-gateway,
        cluster.istio-passthrough-gateway,
        cluster.istio-system,
        cluster.metrics-server,
        cluster.velero,
        cluster.vector,
        cluster.grafana,
        cluster.keycloak,
        cluster.authservice,
        cluster.falco,
        cluster.zarf,
        cluster.loki,
        external-apps,
        external-services,
        istio-admin-gateway,
        istio-tenant-gateway,
        metrics-api-service,
        pepr-validating-webhook,
        pepr-mutating-webhook,
        istio-mutating-webhook,
        zarf-mutating-webhook,
        kubernetes-control-plane,

      // exclude any observability relationships and tagged elements
      exclude
        * where tag is #observability,
        * -> *
          where kind is observability
    }
  }

  view indepth-uds-core of infrastructure {
    title "Overviews / Pods"
    autoLayout TopBottom 150 50

    group {
      border solid
      color background
      opacity 100%

      include
        *,
        cluster.generic-customer.*,
        cluster.pepr-system.*,
        cluster.istio-egress-ambient.*,
        cluster.istio-egress-gateway,
        cluster.istio-egress-gateway.*,
        cluster.istio-passthrough-gateway,
        cluster.istio-passthrough-gateway.*,
        cluster.istio-system.*,
        cluster.metrics-server.*,
        cluster.velero,
        cluster.velero.*,
        cluster.vector.*,
        cluster.monitoring.*,
        cluster.grafana.*,
        cluster.keycloak.*,
        cluster.authservice.*,
        cluster.falco.*,
        cluster.zarf.*,
        cluster.loki.*,
        external-apps.*,
        external-services.*,
        istio-admin-gateway.*,
        istio-tenant-gateway.*,
        metrics-api-service.*,
        pepr-validating-webhook.*,
        pepr-mutating-webhook.*,
        istio-mutating-webhook.*,
        zarf-mutating-webhook.*,
        kubernetes-control-plane.*

      // exclude any observability relationships and tagged elements
      exclude
        * where tag is #observability,
        * -> *
          where kind is observability
    }
	}

  // Functional Layers
  view base-layer of infrastructure {
    title "Functional Layers / Base"

    include
      cluster,
      pepr-system,
      pepr-system.*,
      istio-system,
      istio-system.*,
      istio-admin-gateway,
      istio-admin-gateway.*,
      istio-tenant-gateway,
      istio-tenant-gateway.*,
      cluster.istio-egress-ambient,
      cluster.istio-egress-ambient.*,
      cluster.istio-egress-gateway,
      cluster.istio-egress-gateway.*,
      istio-passthrough-gateway,
      istio-passthrough-gateway.*,
  }

  view identity-authorization-layer of infrastructure {
    title "Functional Layers / Identity & Authorization"

    include
      cluster,
      cluster.keycloak.*,
      cluster.authservice.*,
  }

  dynamic view host-browser-authentication-flow {
    title 'Identity & Authorization / Protected Host Browser Authentication Flow'

    enduser -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'Browser request'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.authservice.authservice 'Check browser session'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> enduser 'Return Authservice redirect to Keycloak'
    enduser -> infrastructure.cluster.keycloak.keycloak 'Sign in'
    enduser -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'Follow callback with authorization code'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.authservice.authservice 'Process callback'
    infrastructure.cluster.authservice.authservice -> infrastructure.cluster.keycloak.keycloak 'Exchange authorization code for tokens'
    infrastructure.cluster.authservice.authservice -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'Provide ID token on the authenticated application request'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.generic-customer.host-proxy 'Forward browser token and application credential'
    infrastructure.cluster.generic-customer.host-proxy -> infrastructure.cluster.generic-customer.custom-application 'Validate UDS identity; strip UDS headers; preserve application Authorization'
  }

  dynamic view host-native-oidc-flow {
    title 'Identity & Authorization / Protected Host with Native OIDC'

    enduser -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'Open the protected host'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.authservice.authservice 'Check browser session'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> enduser 'Redirect to Keycloak for host sign-in'
    enduser -> infrastructure.cluster.keycloak.keycloak 'Sign in and establish a Keycloak SSO session'
    enduser -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'Return to /authservice/callback with the host client’s code'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.authservice.authservice 'Process host callback'
    infrastructure.cluster.authservice.authservice -> infrastructure.cluster.keycloak.keycloak 'Exchange the code for the host client’s tokens'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.generic-customer.custom-application 'Reach the application through the authenticated host'
    infrastructure.cluster.generic-customer.custom-application -> enduser 'Start OIDC sign-in with the application’s client ID'
    enduser -> infrastructure.cluster.keycloak.keycloak 'Follow the redirect with the existing SSO cookie'
    infrastructure.cluster.keycloak.keycloak -> enduser 'Recognize the session and redirect with a new authorization code'
    enduser -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'Return to /auth/callback'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.generic-customer.custom-application 'Forward native OIDC callback'
    infrastructure.cluster.generic-customer.custom-application -> infrastructure.cluster.keycloak.keycloak 'Exchange the code for the application client’s tokens'
    infrastructure.cluster.generic-customer.custom-application -> enduser 'Validate the ID token and start the application session'
  }

  dynamic view host-machine-authentication-flow {
    title 'Identity & Authorization / Protected Host Machine Authentication Flow'

    host-machine-client -> infrastructure.cluster.keycloak.keycloak 'Client credentials grant'
    infrastructure.cluster.keycloak.keycloak -> host-machine-client 'UDS access token with protected host audience'
    host-machine-client -> infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway 'UDS token and application Authorization'
    infrastructure.cluster.istio-tenant-gateway.istio-tenant-ingress-gateway -> infrastructure.cluster.generic-customer.host-proxy 'Validate approved machine identity; forward credentials'
    infrastructure.cluster.generic-customer.host-proxy -> infrastructure.cluster.generic-customer.custom-application 'Validate UDS identity; strip UDS headers; preserve application Authorization'
  }

  view metrics-server-layer of infrastructure {
    title "Functional Layers / Metrics Server"

    include
      cluster,
      cluster.metrics-server,
      cluster.metrics-server.*,
  }

  view runtime-security-layer of infrastructure {
    title "Functional Layers / Runtime Security"

    include
      cluster,
      cluster.falco.*,
  }

  view logging-layer of infrastructure {
    title "Functional Layers / Logging"

    include
      cluster,
      cluster.loki.*,
      cluster.vector.*,


    // exclude any observability relationships
    exclude * -> *
      where kind is observability
  }

  view monitoring-layer of infrastructure {
    title "Functional Layers / Monitoring"

    include
      cluster,
      cluster.monitoring.*,
      cluster.grafana.*,

    // exclude any observability relationships
    exclude * -> *
      where kind is observability
  }

  view backup-restore-layer of infrastructure {
    title "Functional Layers / Backup & Restore"

    include
      cluster,
      cluster.velero,
      cluster.velero.*,
  }

  view observability-reference-architecture of infrastructure {
    title "Reference Architecture / Observability Stack"

    include
      cluster,
      cluster.monitoring.*,
      cluster.grafana.*,
      cluster.generic-customer.*,
      cluster.loki.*,
      cluster.vector.*,
      external-apps.ext-alerts,
      admin,

    exclude
      cluster.generic-customer.customer-waypoint,
      cluster.loki.loki-read,
      cluster.loki.loki-write,
      cluster.monitoring.kube-state-metrics,
      cluster.monitoring.node-exporter,
      * -> *
        where kind is not observability

      autoLayout LeftRight 200 100
  }
}
