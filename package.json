{
  "name": "uds-core",
  "version": "0.6.0",
  "description": "A collection of capabilities for UDS Core",
  "keywords": [
    "k8s",
    "policy-engine",
    "security"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "k3d-setup": "k3d cluster delete uds-core-dev && k3d cluster create uds-core-dev --k3s-arg '--debug@server:0'",
    "test:unit": "go -C src/go-controller test -race ./...",
    "format": "eslint \"**/*.ts\" --fix && prettier --write \"**/*.ts\"",
    "format:check": "eslint \"**/*.ts\" && prettier --check \"**/*.ts\"",
    "test:reference": "python3 src/go-controller/hack/reference-tests.py"
  },
  "dependencies": {
    "kubernetes-fluent-client": "3.12.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "vitest": "^4.1.11",
    "js-yaml": "4.3.2",
    "@kubernetes/client-node": "1.4.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  }
}
